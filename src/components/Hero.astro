<section class="hero" tabindex="0" aria-label="Gordon Freeman. Click, then move with W A S D, Space to jump, Shift to walk, C to crouch. Click again to swing.">
	<canvas aria-hidden="true"></canvas>
</section>

<style>
	.hero {
		position: relative;
		height: 100svh; /* svh, not dvh: the canvas shouldn't resize as mobile toolbars slide */
		margin-inline: -1.5rem;
		outline: none;
		cursor: pointer;
	}
	canvas {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
		image-rendering: pixelated; /* the scene renders at 720 rows; scale it up hard-edged */
	}
	/* Mouse clicks get no ring; keyboard users tabbing in still see where focus went. */
	.hero:focus-visible {
		outline: 1px dashed var(--muted);
		outline-offset: -1px;
	}
</style>

<script>
	// Loads three.js and the model only once the hero scrolls into view.
	const stage = document.querySelector<HTMLElement>('.hero')!;
	const io = new IntersectionObserver(async ([entry]) => {
		if (!entry.isIntersecting) return;
		io.disconnect();
		const { mountScene } = await import('../scripts/scene');
		mountScene(stage.querySelector('canvas')!, stage);
	});
	io.observe(stage);
</script>
